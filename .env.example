# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/psychiatric_ehr
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Security & Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=PsychiatricEHR

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-characters
BSN_ENCRYPTION_KEY=your-bsn-encryption-key-here

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# AI Services
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Presidio (PII Anonymization)
PRESIDIO_ANALYZER_URL=http://localhost:5001
PRESIDIO_ANONYMIZER_URL=http://localhost:5002

# FHIR
FHIR_VERSION=R4
FHIR_BASE_URL=https://vonk.fire.ly

# File Storage
AUDIO_STORAGE_PATH=/var/psychiatric_ehr/audio
MAX_AUDIO_FILE_SIZE_MB=500
ALLOWED_AUDIO_FORMATS=["mp3","wav","m4a"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application
APP_NAME=Psychiatric EHR System
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Session
SESSION_TIMEOUT_MINUTES=30

# GDPR Compliance
DATA_RETENTION_YEARS=7
AUTO_ANONYMIZE_AFTER_YEARS=10

# Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
